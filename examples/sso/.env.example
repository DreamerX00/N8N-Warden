# ── Copy to .env and fill in. NEVER commit the real .env. ─────────────────

# Public hostname users reach n8n at. Needs a DNS A/AAAA record → this host.
N8N_DOMAIN=n8n.example.com

# n8n version to pin (matches the tag you run elsewhere).
N8N_TAG=2.34.5

GENERIC_TIMEZONE=UTC

# ── Your IdP (OIDC) ───────────────────────────────────────────────────────
# The OIDC issuer / discovery base. oauth2-proxy appends
# /.well-known/openid-configuration to it.
#   Keycloak:   https://idp.example.com/realms/YOUR_REALM
#   Authentik:  https://idp.example.com/application/o/n8n/
#   Azure/Entra https://login.microsoftonline.com/TENANT_ID/v2.0
#   Okta:       https://YOUR_ORG.okta.com
#   Google:     https://accounts.google.com
#   CloudKeeper Prism: if Prism gives you an OIDC app, use the issuer URL it
#     shows; register redirect https://${N8N_DOMAIN}/oauth2/callback.
#     If Prism only offers SAML (e.g. fronting AWS IAM Identity Center), do NOT
#     use oauth2-proxy — use the Authentik-broker variant (see README §8).
OIDC_ISSUER_URL=https://idp.example.com/realms/your-realm

# The OAuth client you register in the IdP for n8n.
# Redirect/callback URL to register there:  https://${N8N_DOMAIN}/oauth2/callback
OIDC_CLIENT_ID=n8n
OIDC_CLIENT_SECRET=replace-me

# 32-byte base64 cookie-signing key for oauth2-proxy.
# Generate:  openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=replace-me-openssl-rand-base64-32
