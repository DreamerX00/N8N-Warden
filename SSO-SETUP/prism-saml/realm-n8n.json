  "browserFlow": "browser-prism",
  "authenticationFlows": [
    {
      "alias": "browser-prism",
      "description": "browser based authentication, redirected straight to Prism",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "prism-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "prism-redirector",
      "config": {
        "defaultProvider": "prism"
      }
    }
  ]
}
