# ── Copy to .env and fill in. NEVER commit the real .env. ─────────────────

# Public hostname users reach n8n at. Needs a DNS A/AAAA record → this host.
N8N_DOMAIN=n8n.example.com

# n8n version to pin (matches the tag you run elsewhere).
# 2.34.6 is the current 2.x stable as of 2026-08-17.
N8N_TAG=2.34.6

GENERIC_TIMEZONE=UTC

# ── Your IdP (OIDC) ───────────────────────────────────────────────────────
# The OIDC issuer / discovery base. oauth2-proxy appends
# /.well-known/openid-configuration to it.
#   Keycloak:   https://idp.example.com/realms/YOUR_REALM
#   Authentik:  https://idp.example.com/application/o/n8n/
#   Azure/Entra https://login.microsoftonline.com/TENANT_ID/v2.0
#   Okta:       https://YOUR_ORG.okta.com
#   Google:     https://accounts.google.com
#
#   CloudKeeper Prism: Prism is SAML-only downstream — its admin portal offers
#     "Custom Applications ... to third-party services that support SAML 2.0",
#     and its OIDC support is for IdPs *upstream* of Prism, not for apps below
#     it. oauth2-proxy cannot talk to it directly. Use the broker variant:
#         SSO-SETUP/prism-saml/README.md
#     and then set the issuer to Keycloak, on your own domain:
#         OIDC_ISSUER_URL=https://${N8N_DOMAIN}/auth/realms/n8n
#         OIDC_CLIENT_ID=n8n-gateway
OIDC_ISSUER_URL=https://idp.example.com/realms/your-realm

# The OAuth client you register in the IdP for n8n.
# Redirect/callback URL to register there:  https://${N8N_DOMAIN}/oauth2/callback
OIDC_CLIENT_ID=n8n
OIDC_CLIENT_SECRET=replace-me

# 32-byte base64 cookie-signing key for oauth2-proxy.
# Generate:  openssl rand -base64 32 | tr '+/' '-_'
#   (the tr matters: oauth2-proxy URL-base64-decodes this value, and a raw
#    '+' or '/' makes it fall back to the 44-char string and refuse to start)
OAUTH2_PROXY_COOKIE_SECRET=replace-me-openssl-rand-base64-32

# ── Only for the prism-saml/ broker variant ───────────────────────────────
# Ignored by the plain Caddy / nginx-alb stacks.
# KC_DB_PASSWORD=replace-me-openssl-rand-base64-24
# KC_ADMIN_USER=admin
# KC_ADMIN_PASSWORD=replace-me-openssl-rand-base64-24
